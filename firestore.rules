rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user document holds the person's profile + which book they belong to.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // A book is shared between (up to two) partners.
    match /books/{bookId} {
      // Anyone signed in may read a book — this is required so a partner can
      // look a book up by its invite code before they are a member.
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // An existing member may update or leave (their uid is present *before*
      // the write), and a new partner may join (their uid is present *after*).
      allow update: if request.auth != null && (
        resource.data.members.hasAny([request.auth.uid]) ||
        request.resource.data.members.hasAny([request.auth.uid])
      );
      allow delete: if request.auth != null
        && resource.data.members.hasAny([request.auth.uid]);

      // Photos live in a subcollection and are readable/writable only by members.
      match /photos/{photoId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/books/$(bookId)).data.members.hasAny([request.auth.uid]);
      }
    }
  }
}
